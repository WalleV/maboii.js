{
  "name": "maboii",
  "version": "1.1.0",
  "description": "amiibo™ encryption/decryption library",
  "main": "dist/maboii.cjs",
  "module": "dist/maboii.js",
  "types": "dist/maboii.d.ts",
  "exports": {
    ".": {
      "types": "./dist/maboii.d.ts",
      "import": "./dist/maboii.js",
      "require": "./dist/maboii.cjs",
      "default": "./dist/maboii.js"
    }
  },
  "homepage": "https://github.com/Entrivax/maboii.js#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Entrivax/maboii.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "dev": "rolldown build --config rolldown.config.mjs --watch",
    "build": "pnpm run clean && tsc --emitDeclarationOnly && rolldown build --config rolldown.config.mjs"
  },
  "keywords": [
    "amiibo",
    "maboii"
  ],
  "author": "Entrivax (entrivax@gmail.com)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.9",
    "rolldown": "^0.13.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {},
  "packageManager": "pnpm@10.13.1"
}
